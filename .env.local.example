# Fridgenie Admin — environment variables
# Copy to `.env.local` for local dev, and set the same keys in the Vercel
# project settings for production.

# Public (safe to expose to the browser) — used by the anon Supabase client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY secret — service-role key. Bypasses RLS; used only by the
# /api/admin/* route handlers. NEVER prefix this with NEXT_PUBLIC and never
# expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
